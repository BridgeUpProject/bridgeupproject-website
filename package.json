{
  "name": "bridgeupproject-website",
  "version": "1.0.0",
  "description": "Static marketing site for The Bridge Up Project. Four hand-written HTML pages, one stylesheet, self-hosted fonts and animation libraries, no build step.",
  "homepage": "https://github.com/BridgeUpProject/bridgeupproject-website#readme",
  "bugs": {
    "url": "https://github.com/BridgeUpProject/bridgeupproject-website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BridgeUpProject/bridgeupproject-website.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "check": "npm run check:encoding && npm run check:chrome",
    "check:chrome": "node scripts/check-chrome.js",
    "check:encoding": "node scripts/check-encoding.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "serve": "node server.js"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "finalhandler": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "rough-notation": "^0.5.1",
    "serve-static": "^2.2.1"
  }
